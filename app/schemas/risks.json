      "options":[ "Name", "Category" ],
      "display_on_frontend": false,
      "required": true,
      "span": 12,
      "default": "Name"
    },
    {
      "fieldname": "risk_name",
      "fieldtype": "Data",
      "label": "Risk Name",
      "display_on_frontend": false,
      "required": false,
      "hidden": true,
      "span": 12,
      "validation": {
        "min_length": 5,
        "max_length": 200
      }
    },
    {
      "fieldname": "risk_category",
      "fieldtype": "Select",
      "label": "Risk Category",
