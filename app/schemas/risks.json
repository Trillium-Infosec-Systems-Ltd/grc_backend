      "relationship_direction": "incoming",
      "required": true,
      "span": 12,
      "default_label": false,
      "display_on_frontend": true,
      "disable_on_field": "risk_by_asset",
      "disable_on_value": "Name",
      "isFetchingData": true,
      "fetch_to": {
        "isCall": {"risk_by_asset": "Category"},
        "to": "/data/asset_type",
        "path_params": ["type"]
      },
       "is_filter":true
    },
    {
      "fieldname": "asset_value",
