        "label": "Created at",
        "span": 12,
        "default_label": false,
        "display_on_frontend": false,
        "required": false,
        "hidden": true
      },
      {
        "fieldname": "updated_at",
        "fieldtype": "Datetime",
        "label": "Updated at",
        "span": 12,
        "default_label": false,
        "display_on_frontend": false,
        "required": false,
        "hidden": true
      }
    
    ]
}