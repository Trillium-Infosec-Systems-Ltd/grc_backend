{
    "doctype": "asset_type",
    "fields": [
      {
        "fieldname": "type_name",
        "fieldtype": "Data",
        "label": "Type Name",
        "default_label": true,
        "required": true,
        "display_on_frontend": true,
        "span": 12,
        "validation": {
          "min_length": 2,
          "max_length": 100
        }
      },
      {
        "fieldname": "owner",
        "fieldtype": "Data",
        "label": "Owner",
        "required": true,
        "default_label": false,
        "display_on_frontend": true,
        "span": 12
      },
      {
        "fieldname": "department",
        "fieldtype": "Link",
        "label": "Department",
        "link_to": "department",
        "target_field": "department_name",
        "relationship_type": "owns",
        "relationship_direction": "incoming",
        "display_on_frontend": true,
        "required": false,
        "span": 12
      },
      {
        "fieldname": "asset_value",
        "fieldtype": "Select",
        "label": "Criticality",
        "options": ["Low", "Medium", "High"],
        "default": "Medium",
        "display_on_frontend": true,
        "required": true,
        "span": 12
      },
      {
      "fieldname": "security_controls",
      "fieldtype": "MultiLink",
      "label": "Security Controls Categories Present",
      "link_to": "control",
      "target_field":"control_id",
      "relationship_type": "HAS_CONTROL",
      "relation_direction": "outgoing",
      "display_on_frontend": true,
      "required": true,
      "span": 12
    },
      {
        "fieldname": "created_at",
        "fieldtype": "Datetime",
        "label": "Created at",
        "span": 12,
        "default_label": false,
        "display_on_frontend": false,
        "required": false,
        "hidden": true
      },
      {
        "fieldname": "updated_at",
        "fieldtype": "Datetime",
        "label": "Updated at",
        "span": 12,
        "default_label": false,
        "display_on_frontend": false,
        "required": false,
        "hidden": true
      }
    ]
  }  



 
 