      "target_field": "name",
      "relationship_type": "CREATED_BY",
      "relationship_direction": "incoming",
      "display_on_frontend": false,
      "span": 12,
      "required": false
    },
    {
      "fieldname": "created_at",
      "fieldtype": "Datetime",
      "label": "Created At",
      "display_on_frontend": false,
      "span": 12,
      "required": false,
      "hidden": true
    },
    {
      "fieldname": "updated_at",
      "fieldtype": "Datetime",
      "label": "Updated At",
      "display_on_frontend": false,
      "span": 12,
      "required": false,
      "hidden": true
