      "span": 12,
      "required": true
    },
    {
      "fieldname": "control_rating",
      "fieldtype": "Select",
      "label": "Control Rating",
      "options": ["Not Assessed", "Low", "Medium", "High"],
      "display_on_frontend": true,
      "span": 12,
      "required": false,
      "default": "Not Assessed"
    },
    {
      "fieldname": "compliance_status",
      "fieldtype": "Select",
      "label": "Compliance Status",
      "options": ["Not Assessed", "Non-Compliant", "Partially Compliant", "Compliant"],
      "display_on_frontend": true,
      "span": 12,
      "required": false,
