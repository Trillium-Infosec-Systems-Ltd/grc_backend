{
  "doctype": "Asset",
  "fields": [
    {
      "fieldname": "asset_name",
      "fieldtype": "Data",
      "label": "Asset Name",
      "default_label": true,
      "required": true,
      "display_on_frontend": true,
      "span": 12,
      "validation": {
        "min_length": 2,
        "max_length": 100
      }
    },
    {
      "fieldname": "asset_id",
      "fieldtype": "Data",
      "label": "Asset ID",
      "default_label": true,
      "required": false,
      "display_on_frontend": true,
      "span": 12,
      "validation": {
        "min_length": 2,
        "max_length": 100
      },
      "hidden": true
    },
    {
      "fieldname": "type",
      "fieldtype": "Link",
      "label": "Asset Category",
      "link_to": "asset_type",
      "target_field": "type_name",
      "relationship_direction":"outgoings",
      "relationship_type":"has",
      "required": true,
      "span": 12,
      "default_label": false,
      "display_on_frontend": true,
      "isFetchingData": true,
      "fetch_to": {
        "to": "/data/asset_type",
        "query_params": [],
        "path_params": ["type"]
      }
    },
    {
      "fieldname": "owner",
      "fieldtype": "Link",
      "label": "Owner",
      "link_to": "users",
      "target_field":"name",
      "relationship_direction":"incoming",
      "relationship_type":"owns",
      "span": 12,
      "default_label": false,
      "display_on_frontend": false,
      "required": true
    },
    {
      "fieldname": "environment",
      "fieldtype": "Select",
      "label": "Environment",
      "options": ["Staging", "Dev", "Production"],
      "required": false,
      "default_label": false,
      "span": 12,
      "display_on_frontend": false,
      "default": "Staging"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "link_to": "department",
      "target_field": "department_name",
       "relationship_direction":"incoming",
      "relationship_type":"owns",
      "display_on_frontend": false,
      "span": 12,
      "required": false
    },
     {
      "fieldname": "ip_hostname",
      "fieldtype": "Data",
      "label": "IP/Hostname",
      "display_on_frontend": false,
      "required": false,
      "span": 12,
      "default_label": false,
      "validation": {
        "regex": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}|[a-zA-Z0-9\\-]+(\\.[a-zA-Z0-9\\-]+)+)$"
      }
    },
     {
      "fieldname": "asset_value",
      "fieldtype": "Select",
      "label": "Criticality",
      "options": ["Low", "Medium", "High"],
      "required": true,
      "default_label": false,
      "span": 12,
      "display_on_frontend": true,
      "is_colorful": true,
      "default": "Medium",
      "data_field": "asset_value"
    },
    {
      "fieldname": "exposure",
      "fieldtype": "Select",
      "label": "Exposure Level",
      "options": ["Internal", "External"],
      "required": false,
      "default_label": false,
      "span": 12,
      "display_on_frontend": false,
      "defaultValue": "Internal"
